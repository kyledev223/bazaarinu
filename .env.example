# Bazaar Inu: environment variables. Placeholders only; never commit real values.
# Local: copy to .env. Vercel: Project → Settings → Environment Variables, then redeploy.
# Full table with where to get each value: docs/LAUNCH.md

# --- required -------------------------------------------------------------
# Postgres. On Neon use the POOLED connection string here (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
# Optional but recommended on Neon: the DIRECT (non-pooled) string, used only by `prisma migrate deploy`.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Comma-separated mainnet RPC URLs, best first. The public endpoint is appended automatically as the last resort.
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY"

# Your public URL, no trailing slash. Shown in sign-in messages and metadata.
SITE_URL="https://your-domain.example"

# 32+ random characters. Protects /api/cron. Generate: openssl rand -base64 32
CRON_SECRET="replace-with-a-long-random-string"

# --- metadata upload --------------------------------------------------------
# Strongly recommended: pump.fun's own upload endpoint currently returns HTTP 500 to servers.
PINATA_JWT=""
# Optional dedicated gateway host, e.g. "yourname.mypinata.cloud". Default is ipfs.io.
PINATA_GATEWAY=""

# --- optional ---------------------------------------------------------------
# SOL price: CoinGecko first (key optional), then Coinbase and Kraken (no keys).
COINGECKO_API_KEY=""
# "demo" (default) or "pro"
COINGECKO_API_PLAN="demo"
# Backtester price history: GeckoTerminal needs no key; Birdeye is the optional fallback.
BIRDEYE_API_KEY=""

# Public, shown in the UI (not secrets).
NEXT_PUBLIC_X_HANDLE=""
NEXT_PUBLIC_OFFICIAL_MINT=""
NEXT_PUBLIC_TELEGRAM_URL=""
